<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
