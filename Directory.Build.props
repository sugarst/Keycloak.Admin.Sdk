<Project>
  <Import Project="$(MSBuildThisFileDirectory)Target.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Deterministic>true</Deterministic>
    <PackageProjectUrl>https://github.com/sugarst/Keycloak.Admin.Sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sugarst/Keycloak.Admin.Sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
