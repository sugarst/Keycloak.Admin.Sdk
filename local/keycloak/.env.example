# Service.cs creates .env automatically with random passwords on the first up.
# Values below document the supported settings. Keep the generated passwords.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_PORT=15432
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-admin-password
KEYCLOAK_HTTP_PORT=18080
KEYCLOAK_MANAGEMENT_PORT=19000
KEYCLOAK_FEATURES=admin-fine-grained-authz:v2,workflows
