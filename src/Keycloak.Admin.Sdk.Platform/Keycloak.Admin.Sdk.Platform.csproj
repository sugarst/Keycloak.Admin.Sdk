    <PackageReference Include="Microsoft.FeatureManagement" Version="4.8.0" />
    <PackageReference Include="Microsoft.FeatureManagement.Telemetry.ApplicationInsights" Version="4.8.0" />
    <EmbeddedResource Include="../../contracts/feature-flag-catalog.json" LogicalName="Keycloak.Admin.Sdk.Platform.FeatureFlagCatalog.json" />
